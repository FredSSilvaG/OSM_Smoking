View(gene_family_trim)
gene_family_trim$Gene_Family <- sub(".*\\|", "", gene_family_trim$Gene_Family)
gene_family_trim <- aggregate(. ~ Gene_Family, data = gene_family_trim, FUN = sum, na.rm = TRUE)
d <- gene_family_trim[87,-1]
View(d)
