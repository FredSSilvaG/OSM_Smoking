# calculate the prevalence at each threshold
count_prevalence_steps <- function(column) {
# Define the sequence of prevalence thresholds
# Adapt the value until where, such that we can see small counts if necessary
thresholds <- seq(1, 0, by = -0.05)
# Count the occurrences for each threshold
counts <- sapply(thresholds, function(threshold) sum(column >= threshold))
# Return the counts as a named vector
names(counts) <- thresholds
return(counts)
}
# plots the calculated prevalences for each threshold
plot_prevalence_counts <- function(prevalence_counts) {
# Plot the results
plot(
x = names(prevalence_counts), # Names of the vector as x-axis labels
y = prevalence_counts,        # Counts as y values
type = "o",                   # "o" for lines and points
xlab = "Prevalence Threshold",
ylab = "Counts",
main = "Number of species with a certain prevalence",
col = "darkblue",
pch = 16 # Filled circles for points
)
# Rotate x-axis labels for better readability
axis(1, at = seq_along(names(prevalence_counts)), labels = names(prevalence_counts), las = 2, cex.axis=0.8)
# Add grid lines for better readability
grid()
}
# Load of data
#Read metadata
metadata <- read.csv("../INPUT/OSM_metadata_smoke_s_contact lenses_complete.csv", sep = ",", header = TRUE)
# Load the RDS file
data <- readRDS("../INPUT/metaphlan/merged_output.rds")
#-------
#Data Preparation
#Metadata smokers
metadata_smokers <- metadata[metadata$treatment!="contact lense", ]
metadata_smokers <- metadata_smokers[metadata_smokers$treatment!="positive control", ]
metadata_smokers <- metadata_smokers[metadata_smokers$treatment!="negative control", ]
metadata_smokers$sample <- gsub("_$","", metadata_smokers$sample )
metadata_smokers <-metadata_smokers[metadata_smokers$sample_name!="18_CR", ]
#Preparation of Data RDS
#Selecting only the species level
data_species <- data$species
colnames(data_species) <- gsub("*X","", colnames(data_species) )
colnames(data_species) <- gsub("_metaphlan","", colnames(data_species) )
data_species <- data_species[!grepl("k__Eukaryota", data_species$clade_name), ]
###Data filtering from both datasets
#Identify columns to keep (keeping the first column explicitly)
columns_to_keep <-c(colnames(data_species)[1],metadata_smokers$sample)
# Subset abundance table filtered with the selected columns
data_species_filtered <- data_species[, columns_to_keep, drop = FALSE]
#Assign colnames as in sample_names
colnames(data_species_filtered)[-1] <- metadata_smokers$sample_name[match(colnames(data_species_filtered)[-1], metadata_smokers$sample)]
###Removal of samples with no reads
#Remove species that do not have any presence (among the samples) in the dataframe
data_species_filtered <- data_species_filtered[rowSums(data_species_filtered[,2:ncol(data_species_filtered)]) > 0, ]
#Remove samples that do not have any species
data_species_filtered <- data_species_filtered[, colSums(data_species_filtered != 0) > 0]
#Re-filter metadata with data_species_filtered
metadata_smokers <- metadata_smokers[metadata_smokers$sample_name %in% colnames(data_species_filtered), ]
#Create a vector of number and names of sample columns
abundance_columns <- colnames(data_species_filtered)[-1]
nsamples <- ncol(data_species_filtered)
#Keep a copy of the filtered data without stats for next steps
data_species_filtered_analysis_base <- data_species_filtered
#Add 1st column as rownames
data_species_filtered_analysis <- data_species_filtered_analysis_base
rownames(data_species_filtered_analysis) <- data_species_filtered_analysis[, 1]
data_species_filtered_analysis <- data_species_filtered_analysis[, -1]
####Statistics
#Adding some statistics
data_species_filtered$Mean <-apply(data_species_filtered[,2:nsamples], 1, mean) #Mean
data_species_filtered$Media <- apply(data_species_filtered[,2:nsamples], 1, median) #Median
data_species_filtered$presence_proportion <- rowSums(data_species_filtered[,2:nsamples] > 0)/(nsamples-1) #Prevalence in decimals
data_species_filtered$Abs_presense <- rowSums(data_species_filtered[,2:nsamples] > 0) #Absolute presence of species per sample
ncol(data_species_filtered)
#Check if there are 0 presence of species in the dataframe among the samples
round(rowSums(data_species_filtered[, abundance_columns], na.rm = TRUE), 5)
round(colSums(data_species_filtered[, abundance_columns], na.rm = TRUE), 5)
#apply(data_species_filtered[,2:ncol(data_species_filtered)], 1, median)
